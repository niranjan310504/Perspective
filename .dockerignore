# Perspective - Docker Ignore File
# Excludes files from Docker build context

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
*.egg-info
.eggs

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox

# Node
node_modules/
npm-debug.log

# Build artifacts
build/
dist/
*.egg

# Documentation
docs/
*.md
!README.md

# Data (large files - mount as volume instead)
data/raw/
data/processed/
*.csv

# Notebooks
notebooks/
*.ipynb

# Scripts (not needed for runtime)
scripts/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
