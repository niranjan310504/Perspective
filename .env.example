# ===========================================
# Perspective - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ----- Required in Production -----

# Flask secret key (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# ----- Optional (with defaults) -----

# Flask environment: development or production
FLASK_ENV=development

# Model directory path (default: model/checkpoints)
# MODEL_DIR=model/checkpoints

# Force CPU/CUDA device (default: auto-detect)
# MODEL_DEVICE=cpu

# CORS origins (comma-separated, default: localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- API Keys (for data collection only) -----

# Gemini API key for LLM labeling (optional)
# Get from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# NewsAPI key for news collection (optional)
# Get from: https://newsapi.org
# NEWS_API_KEY=your-newsapi-key
