# Perspective Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Google Fact Check API
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "Fact Check Tools API" in your Google Cloud project
GOOGLE_FACT_CHECK_API_KEY=your-google-api-key-here

# Model Configuration (optional)
MODEL_DIR=model/checkpoints
MODEL_DEVICE=  # Leave empty for auto-detect, or set to 'cpu' or 'cuda'

# Logging
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
